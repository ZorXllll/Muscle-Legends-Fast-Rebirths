local Industrial = AutoFarm:AddFolder("Auto Farm Industrial Gym")

local function setupFarm(folder, switchName, cframeData, startEnabled)
    local toggleState = false
    
    local switch = folder:AddSwitch(switchName, function(State)
        toggleState = State
        if State then
            task.spawn(function()
                local vim = game:GetService("VirtualInputManager")
                local player = game:GetService("Players").LocalPlayer
                
                while toggleState do
                    local char = player.Character
                    if char and char.PrimaryPart then
                        char:SetPrimaryPartCFrame(cframeData)
                        vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                        task.wait()
                        vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                        player.muscleEvent:FireServer("rep")
                    end
                    task.wait(0.1)
                end
            end)
        end
    end)

    if startEnabled then
        task.spawn(function()
            task.wait(0.5)
            if switch and typeof(switch.Set) == "function" then
                pcall(function()
                    switch:Set(true)
                end)
            else
                toggleState = true
                task.spawn(function()
                    local vim = game:GetService("VirtualInputManager")
                    local player = game:GetService("Players").LocalPlayer
                    while toggleState do
                        local char = player.Character
                        if char and char.PrimaryPart then
                            char:SetPrimaryPartCFrame(cframeData)
                            vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                            task.wait()
                            vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                            player.muscleEvent:FireServer("rep")
                        end
                        task.wait(0.1)
                    end
                end)
            end
        end)
    end
end

